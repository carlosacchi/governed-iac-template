# Platform-owned paths. With "Require review from Code Owners" enabled on main,
# a PR touching them waits for the platform reviewer, whoever wrote it (a person or Copilot).
# There is deliberately no catch-all owner: the PR author cannot approve their own PR,
# so owning everything would block the maintainers' own changes, including the demo PRs.

# Gates, checks, demo reset and the tests that guard them
/scripts/              @YOUR-ORG/platform-team
/tests/                @YOUR-ORG/platform-team
/package.json          @YOUR-ORG/platform-team

# Pipelines, Copilot instructions and this file
/.github/              @YOUR-ORG/platform-team

# Infrastructure owned by the platform
/infra/bootstrap/      @YOUR-ORG/platform-team
/infra/modules/        @YOUR-ORG/platform-team
/infra/compare/        @YOUR-ORG/platform-team
/infra/workload/       @YOUR-ORG/platform-team
/demo/baseline/        @YOUR-ORG/platform-team

# Team files: no owner on purpose. This is where teams and agents propose changes;
# the decision is taken later by the gates and by the environment approval.
/infra/workload/teams/
